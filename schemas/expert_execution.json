{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Captured expert execution recipe",
  "description": "Product-owned payload inside subagent.stream.requested.execution. It is not a kernel concept or permission to replay old work. Factories and credential values are not serialized.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "identity", "revision", "activation", "model_id", "assembly", "components", "credential_names"],
  "properties": {
    "v": {"const": 1},
    "identity": {"$ref": "#/$defs/identity"},
    "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "activation": {"$ref": "#/$defs/auditReference"},
    "model_id": {"type": "string"},
    "assembly": {"$ref": "assembly_manifest.json"},
    "components": {"type": "object", "additionalProperties": {"$ref": "component_manifest.json"}},
    "credential_names": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "root", "id"],
      "properties": {
        "scope": {"enum": ["project", "personal"]},
        "root": {"type": "string"},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
      }
    },
    "auditReference": {
      "type": "object", "additionalProperties": false,
      "required": ["ledger", "stream", "event"],
      "properties": {"ledger": {"type": "string"}, "stream": {"type": "string"}, "event": {"type": "string"}}
    }
  }
}
